# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Express server port (default 3000)
PORT="3000"

# FIREBASE_PROJECT_ID: Optional override for server-side Firebase ID token verification.
# Defaults to projectId in firebase-applet-config.json if unset.
FIREBASE_PROJECT_ID=""

# ANDROID RELEASE SIGNING (Optional, for local/CI signed APK & AAB builds - never commit real values)
ANDROID_KEYSTORE_PATH=""
ANDROID_KEYSTORE_PASSWORD=""
ANDROID_KEY_ALIAS=""
ANDROID_KEY_PASSWORD=""
